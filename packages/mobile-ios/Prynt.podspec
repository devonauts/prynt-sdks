# CocoaPods spec for the Prynt iOS SDK. Published from the split repository pryntid/prynt-ios
# (generated by scripts/sdk/export-public.sh), which holds this package at its root.
Pod::Spec.new do |s|
  s.name                  = 'Prynt'
  s.version               = '1.0.0'
  s.summary               = 'Prynt iOS SDK: stable device identity and integrity signals, verified server-side.'
  s.description           = 'Identify an app install with a stable visitorId (Keychain-persisted, survives reinstall), ' \
                            'collect jailbreak / instrumentation / cloned-app tells and App Attest tokens, and verify ' \
                            'the result on your server with your Prynt secret key.'
  s.homepage              = 'https://pryntid.com'
  s.license               = { :type => 'MIT', :file => 'LICENSE' }
  s.author                = { 'Prynt' => 'support@pryntid.com' }
  s.source                = { :git => 'https://github.com/devonauts/prynt-ios.git', :tag => "v#{s.version}" }
  s.ios.deployment_target = '13.0'
  s.swift_version         = '5.7'
  s.source_files          = 'Sources/Prynt/**/*.swift'
  s.frameworks            = 'Foundation', 'UIKit', 'Security', 'DeviceCheck', 'CryptoKit'
end
